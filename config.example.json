{
  "active_library": 1,
  "db_path": "",
  "autosave_interval": 60,
  "_analysis_workers_comment": "Optional. Processes for audio analysis. Omit for three quarters of the cores. Analysis is CPU-bound; measured scaling flattens past about 12 workers.",
  "analysis_workers": 0,
  "_database_comment": [
    "Optional. Omit this section entirely to use SQLite at db_path.",
    "For MySQL/MariaDB, set backend to 'mysql' and fill in the rest.",
    "Use either 'password' or 'password_env' (an environment variable",
    "name); password_env wins when the variable is set, so a shared or",
    "backed-up config need not carry the credential."
  ],
  "database": {
    "backend": "sqlite",
    "host": "your-db-server",
    "port": 3306,
    "name": "classical_manager",
    "user": "cmanager",
    "password": "",
    "password_env": "CM_DB_PASSWORD",
    "charset": "utf8mb4"
  },
  "targets": {
    "plex": {
      "base_url": "http://your-plex-server:32400",
      "token": "your-plex-token",
      "music_section": "Music",
      "path_rules": []
    },
    "m3u": {
      "path_style": "absolute",
      "base_path": "",
      "path_rules": []
    }
  },
  "cron": {
    "library": "My Collection",
    "mode": "plex",
    "profile": "",
    "m3u_output_dir": "~/Playlists",
    "verbosity": "-q"
  },
  "webhook": {
    "host": "0.0.0.0",
    "port": 5588,
    "library": "My Collection",
    "allowed_commands": [
      "plex",
      "scan",
      "scan+plex",
      "scan+m3u",
      "m3u",
      "exclude-track"
    ],
    "token_env": "CM_WEBHOOK_TOKEN"
  }
}
